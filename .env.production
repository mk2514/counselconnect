# PRODUCTION ENV SETTINGS

# Environment
PYTHON_ENV=development
LOG_LEVEL=WARNING

# Web URLs (Custom Domain)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000

# Cookie Settings
COOKIE_DOMAIN=localhost

# Authentication
# Must be generated securely (e.g. openssl rand -hex 32)
SESSION_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_KEY

# Database
POSTGRES_USER=counselconnect_prod
POSTGRES_PASSWORD=SECURE_PROD_PASSWORD
POSTGRES_DB=counselconnect_prod

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis (Session/Celery Broker)
REDIS_PASSWORD=SECURE_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2

# MinIO Storage (Evidence & Documents)
MINIO_ROOT_USER=counselconnect_storage
MINIO_ROOT_PASSWORD=SECURE_STORAGE_PASSWORD
MINIO_ENDPOINT=storage:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=counselconnect-prod-data
MINIO_USE_SSL=False

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://ollama:11434
