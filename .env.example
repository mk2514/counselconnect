# ============================================================
# Counsel Connect Environment Configuration
# Copy this file to .env and fill in actual values.
# Never commit .env to version control.
# ============================================================

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://counselconnect:counselconnect@localhost:5432/counselconnect
DATABASE_URL_SYNC=postgresql://counselconnect:counselconnect@localhost:5432/counselconnect

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Celery ----------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- MinIO (Object Storage) ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=counselconnect
MINIO_USE_SSL=false

# ---------- Ollama (Local LLM) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_TIMEOUT_SECONDS=120

# ---------- Authentication ----------
SESSION_SECRET=change-me-to-a-random-secret-in-production
# Password hashing uses Argon2id (configured in code, no env override needed)

# ---------- Application URLs ----------
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000

# ---------- Storage ----------
STORAGE_MAX_FILE_SIZE_MB=50

# ---------- Environment ----------
NODE_ENV=development
PYTHON_ENV=development
LOG_LEVEL=INFO
